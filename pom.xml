<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Proyecto padre de Spring Boot: define las versiones compatibles de todas
        las librerias (Spring, Jackson, driver de MySQL, JUnit...), por eso las
        dependencias de abajo no llevan <version>.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- Identificacion del proyecto -->
    <groupId>com.finanzafamiliar</groupId>
    <artifactId>finanzafamiliar-backend</artifactId>
    <version>2.0.0</version>
    <!-- jar = aplicacion Spring Boot con servidor Tomcat embebido (ya no es un war) -->
    <packaging>jar</packaging>

    <name>FinanzaFamiliar Backend</name>
    <description>API REST del Sistema de Contabilidad Familiar - modulos de usuarios y movimientos con Spring Boot, JDBC y MySQL</description>

    <properties>
        <!-- Version de Java del proyecto -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- API REST: controladores @RestController, conversion a JSON (Jackson) y Tomcat embebido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Acceso a datos con JDBC: JdbcTemplate y pool de conexiones HikariCP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Validacion de los datos recibidos con anotaciones (@NotBlank, @Email, @Size...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver JDBC de MySQL (el mismo de la version con Servlets) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Pruebas unitarias: JUnit 5, Mockito y MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nombre del archivo generado: target/finanzafamiliar-backend.jar -->
        <finalName>finanzafamiliar-backend</finalName>
        <plugins>
            <!-- Permite ejecutar la API con "mvnw spring-boot:run" y empaquetarla como jar ejecutable -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
