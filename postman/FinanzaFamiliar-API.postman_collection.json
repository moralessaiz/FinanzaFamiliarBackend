    {
      "name": "01 Categorías",
      "description": "Catálogo de categorías de ingreso y gasto (solo lectura).",
      "item": [
        {
          "name": "GET Listar categorías",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde un arreglo con las 4 categorías iniciales\", () => {",
                  "    const categorias = pm.response.json();",
                  "    pm.expect(categorias).to.be.an(\"array\");",
                  "    pm.expect(categorias.length).to.be.at.least(4);",
                  "});",
                  "pm.test(\"Cada categoría tiene id, nombre y tipo\", () => {",
                  "    pm.response.json().forEach(c => pm.expect(c).to.have.all.keys(\"idCategoria\", \"nombre\", \"tipo\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias"
              ]
            },
            "description": "Lista todas las categorías. El front-end las usa para llenar la lista del formulario de movimientos."
          }
        }
      ]
    },
