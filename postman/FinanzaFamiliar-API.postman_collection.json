        {
          "name": "POST Crear usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo único en cada ejecución, para que la prueba se pueda repetir sin error 409",
                  "pm.collectionVariables.set(\"correoPrueba\", \"laura.postman.\" + Date.now() + \"@finanzafamiliar.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201 Created\", () => pm.response.to.have.status(201));",
                  "const usuario = pm.response.json();",
                  "pm.test(\"La API asignó un idUsuario\", () => pm.expect(usuario.idUsuario).to.be.a(\"number\"));",
                  "pm.test(\"Los datos guardados coinciden con los enviados\", () => {",
                  "    pm.expect(usuario.nombre).to.eql(\"Laura Prueba Postman\");",
                  "    pm.expect(usuario.correo).to.eql(pm.collectionVariables.get(\"correoPrueba\"));",
                  "    pm.expect(usuario.rol).to.eql(\"Integrante\");",
                  "});",
                  "// Se guarda el id para usarlo en las siguientes peticiones",
                  "pm.collectionVariables.set(\"idUsuario\", usuario.idUsuario);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Registra un usuario. Guarda el id generado en la variable {{idUsuario}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laura Prueba Postman\",\n  \"correo\": \"{{correoPrueba}}\",\n  \"rol\": \"Integrante\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
